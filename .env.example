# Copy to .env and fill in. .env is gitignored; never commit real values.
# Phase 1 requires NONE of these. Nothing in Phase 1 touches the network.

# --- Target app (Phase 1) ---
TARGET_APP_PORT=3000
# Session idle timeout in seconds. Deliberately short so session-expiry is
# triggerable by hand as well as via the fault toggle.
TARGET_APP_SESSION_TTL_SECONDS=120

# --- Target app operator login (Phase 2+) ---
# Synthetic credentials for the mock app only. Not a real system.
# Injected from env at replay time; never written into a capability artifact.
TARGET_APP_USER=teller01
TARGET_APP_PASSWORD=change-me-locally

# --- LLM provider (Phase 4 only) ---
# The discovery agent talks to an LLMProvider port; the provider is swappable
# here with no code change outside src/llm/providers/.
#
# LLM_PROVIDER=gemini | openai-compatible
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=
#
# openai-compatible covers Groq, OpenRouter, Together, DeepSeek, OpenAI,
# and local Ollama / vLLM — selected by base URL + model id.
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=
# LLM_API_KEY=
