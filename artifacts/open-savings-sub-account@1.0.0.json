{
  "schemaVersion": 1,
  "id": "open-savings-sub-account",
  "name": "Open a savings sub-account for a member",
  "version": "1.0.0",
  "status": "draft",
  "description": "Signs on to MERIDIAN Core, looks up a member by number, reads their current savings balance, then opens a new savings sub-account and reaches the confirmation screen. Returns the balance read before the change and the account number assigned by the core.",

  "target": {
    "surface": "web",
    "app": "meridian-core",
    "appVersion": "0.1.0",
    "entryUrl": "http://localhost:3000/",
    "allowlistRef": "config/allowlist.json"
  },

  "inputs": {
    "operatorId": {
      "type": "string",
      "description": "Operator ID to sign on with. Supplied from the environment at invocation, never stored here.",
      "required": true,
      "sensitivity": "none",
      "example": "teller01"
    },
    "operatorPassword": {
      "type": "string",
      "description": "Password for the operator. Supplied from the environment at invocation. Never logged, never written to evidence, never included in a model request.",
      "required": true,
      "sensitivity": "secret"
    },
    "memberId": {
      "type": "string",
      "description": "Six-digit member number as printed on the member's statement. No example is given: a member number identifies a person, and an example value in a committed artifact is a leak.",
      "required": true,
      "sensitivity": "pii"
    },
    "accountType": {
      "type": "string",
      "description": "Sub-account product to open. Must match one of the options offered on the form: Regular Savings, Holiday Club, Vacation Club, Youth Savings.",
      "required": true,
      "sensitivity": "none",
      "example": "Holiday Club"
    },
    "initialDeposit": {
      "type": "string",
      "description": "Opening deposit as a dollar amount with up to two decimal places, e.g. 25.00. Sent as a string because the form is a text field and rounding it through a float would change what the operator sees.",
      "required": true,
      "sensitivity": "none",
      "example": "25.00"
    }
  },

  "outputs": {
    "savingsBalance": {
      "type": "number",
      "description": "The member's savings balance as displayed before the sub-account was opened.",
      "sensitivity": "pii",
      "extraction": {
        "from": "field_value",
        "parse": "currency_to_number",
        "target": {
          "strategy": "semantic",
          "role": "textbox",
          "name": "Savings Balance",
          "nameSource": "adjacent-cell",
          "scope": {
            "kind": "labelled_group",
            "name": { "kind": "literal", "value": "Balance Summary" }
          },
          "framePath": ["content"]
        }
      }
    },
    "newSubAccountNumber": {
      "type": "string",
      "description": "Account number assigned by the core to the newly opened sub-account. Differs on every invocation — it is server-assigned, not derived from the inputs.",
      "sensitivity": "pii",
      "extraction": {
        "from": "text_content",
        "parse": "trim",
        "target": {
          "strategy": "semantic",
          "role": "cell",
          "name": "",
          "scope": {
            "kind": "table_row",
            "name": { "kind": "literal", "value": "New Sub-Account Number" }
          },
          "ordinal": 1,
          "framePath": ["content"]
        }
      }
    }
  },

  "steps": [
    {
      "id": "open-signon",
      "intent": "Load the MERIDIAN Core sign-on page.",
      "risk": "safe",
      "action": {
        "kind": "navigate",
        "url": { "kind": "literal", "value": "http://localhost:3000/" }
      },
      "postcondition": {
        "kind": "element_present",
        "target": {
          "strategy": "semantic",
          "role": "textbox",
          "name": "Operator ID",
          "nameSource": "label-for",
          "framePath": []
        }
      }
    },
    {
      "id": "enter-operator-id",
      "intent": "Type the operator ID into the sign-on form.",
      "risk": "safe",
      "action": {
        "kind": "type",
        "value": { "kind": "param", "param": "operatorId" },
        "target": {
          "strategy": "semantic",
          "role": "textbox",
          "name": "Operator ID",
          "nameSource": "label-for",
          "framePath": []
        }
      }
    },
    {
      "id": "enter-operator-password",
      "intent": "Type the operator password. The value is bound at invocation and is redacted everywhere it would otherwise be recorded.",
      "risk": "safe",
      "action": {
        "kind": "type",
        "value": { "kind": "param", "param": "operatorPassword" },
        "target": {
          "strategy": "semantic",
          "role": "textbox",
          "name": "Password",
          "nameSource": "label-for",
          "framePath": []
        }
      }
    },
    {
      "id": "submit-signon",
      "intent": "Submit the sign-on form and wait for the console to load its content frame.",
      "risk": "safe",
      "action": {
        "kind": "click",
        "target": {
          "strategy": "semantic",
          "role": "button",
          "name": "Sign On",
          "nameSource": "native",
          "framePath": []
        }
      },
      "postcondition": {
        "kind": "element_present",
        "target": {
          "strategy": "semantic",
          "role": "textbox",
          "name": "Member ID",
          "nameSource": "adjacent-cell",
          "framePath": ["content"]
        }
      }
    },
    {
      "id": "enter-member-id",
      "intent": "Enter the member number in the search box. This control has no accessible name in the markup; the name above is derived from the adjacent label cell.",
      "risk": "safe",
      "action": {
        "kind": "type",
        "value": { "kind": "param", "param": "memberId" },
        "target": {
          "strategy": "semantic",
          "role": "textbox",
          "name": "Member ID",
          "nameSource": "adjacent-cell",
          "framePath": ["content"]
        }
      }
    },
    {
      "id": "run-search",
      "intent": "Run the member search and wait for a result row for this specific member.",
      "risk": "safe",
      "action": {
        "kind": "click",
        "target": {
          "strategy": "semantic",
          "role": "button",
          "name": "Search",
          "nameSource": "native",
          "framePath": ["content"]
        }
      },
      "postcondition": {
        "kind": "element_present",
        "target": {
          "strategy": "semantic",
          "role": "link",
          "name": "View",
          "nameSource": "native",
          "scope": {
            "kind": "table_row",
            "name": { "kind": "param", "param": "memberId" }
          },
          "framePath": ["content"]
        }
      }
    },
    {
      "id": "open-member-detail",
      "intent": "Open the member's detail screen. Every result row has a link named View, so the row is selected by the member number rather than by position.",
      "risk": "safe",
      "action": {
        "kind": "click",
        "target": {
          "strategy": "semantic",
          "role": "link",
          "name": "View",
          "nameSource": "native",
          "scope": {
            "kind": "table_row",
            "name": { "kind": "param", "param": "memberId" }
          },
          "framePath": ["content"]
        }
      },
      "postcondition": {
        "kind": "element_present",
        "target": {
          "strategy": "semantic",
          "role": "textbox",
          "name": "Savings Balance",
          "nameSource": "adjacent-cell",
          "scope": {
            "kind": "labelled_group",
            "name": { "kind": "literal", "value": "Balance Summary" }
          },
          "framePath": ["content"]
        }
      }
    },
    {
      "id": "open-subaccount-form",
      "intent": "Start the sub-account application. Nothing is created by reaching this form.",
      "risk": "safe",
      "action": {
        "kind": "click",
        "target": {
          "strategy": "semantic",
          "role": "button",
          "name": "Open Sub-Account",
          "nameSource": "native",
          "framePath": ["content"]
        }
      },
      "postcondition": {
        "kind": "element_present",
        "target": {
          "strategy": "semantic",
          "role": "combobox",
          "name": "Account Type",
          "nameSource": "title",
          "framePath": ["content"]
        }
      }
    },
    {
      "id": "choose-account-type",
      "intent": "Select the sub-account product.",
      "risk": "sensitive",
      "action": {
        "kind": "select",
        "value": { "kind": "param", "param": "accountType" },
        "target": {
          "strategy": "semantic",
          "role": "combobox",
          "name": "Account Type",
          "nameSource": "title",
          "framePath": ["content"]
        }
      }
    },
    {
      "id": "enter-initial-deposit",
      "intent": "Enter the opening deposit, then assert the field really holds it — a silently rejected keystroke would otherwise open the account for the wrong amount.",
      "risk": "sensitive",
      "action": {
        "kind": "type",
        "value": { "kind": "param", "param": "initialDeposit" },
        "target": {
          "strategy": "semantic",
          "role": "textbox",
          "name": "Initial Deposit",
          "nameSource": "label-for",
          "framePath": ["content"]
        }
      },
      "postcondition": {
        "kind": "field_value",
        "equals": { "kind": "param", "param": "initialDeposit" },
        "target": {
          "strategy": "semantic",
          "role": "textbox",
          "name": "Initial Deposit",
          "nameSource": "label-for",
          "framePath": ["content"]
        }
      }
    },
    {
      "id": "acknowledge-disclosure",
      "intent": "Record that the member acknowledged the account disclosure. Uses check rather than click so the step converges to the same state however many times it runs.",
      "risk": "sensitive",
      "action": {
        "kind": "check",
        "checked": true,
        "target": {
          "strategy": "semantic",
          "role": "checkbox",
          "name": "Disclosure",
          "nameSource": "adjacent-cell",
          "framePath": ["content"]
        }
      }
    },
    {
      "id": "continue-to-review",
      "intent": "Submit the form to the review screen. Still reversible — the core has not been asked to create anything yet.",
      "risk": "sensitive",
      "action": {
        "kind": "click",
        "target": {
          "strategy": "semantic",
          "role": "button",
          "name": "Continue",
          "nameSource": "native",
          "framePath": ["content"]
        }
      },
      "postcondition": {
        "kind": "element_present",
        "target": {
          "strategy": "semantic",
          "role": "button",
          "name": "Confirm and Open Account",
          "nameSource": "native",
          "framePath": ["content"]
        }
      }
    },
    {
      "id": "confirm-open-account",
      "intent": "Commit the new sub-account. This is the point of no return: it posts to the core and cannot be undone by navigating back.",
      "risk": "irreversible",
      "action": {
        "kind": "click",
        "target": {
          "strategy": "semantic",
          "role": "button",
          "name": "Confirm and Open Account",
          "nameSource": "native",
          "framePath": ["content"]
        }
      },
      "postcondition": {
        "kind": "text_present",
        "text": { "kind": "literal", "value": "Sub-Account Opened" }
      }
    }
  ],

  "successCondition": {
    "kind": "element_present",
    "target": {
      "strategy": "semantic",
      "role": "cell",
      "name": "",
      "scope": {
        "kind": "table_row",
        "name": { "kind": "literal", "value": "New Sub-Account Number" }
      },
      "ordinal": 1,
      "framePath": ["content"]
    }
  },

  "knownOutcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
      "description": "No member exists with the supplied member number. A legitimate answer, not a failure — the caller decides what to do about it.",
      "message": "No member exists with the supplied member number.",
      "detector": {
        "kind": "text_present",
        "text": { "kind": "literal", "value": "No member found matching that ID" }
      },
      "checkAfterSteps": ["run-search"]
    },
    {
      "code": "INVALID_DEPOSIT_AMOUNT",
      "description": "The core rejected the opening deposit as not a well-formed dollar amount. The caller supplied a bad argument; nothing was created.",
      "message": "The opening deposit was rejected as not a valid dollar amount.",
      "detector": {
        "kind": "text_present",
        "text": { "kind": "literal", "value": "Initial Deposit must be a dollar amount" }
      },
      "checkAfterSteps": ["continue-to-review"]
    }
  ],

  "recoveries": [
    {
      "id": "dismiss-system-notice",
      "description": "MERIDIAN Core interposes a maintenance notice over the member screen. It is modal and covers the page, so it must be dismissed before any further click can land. Bounded to one attempt: a notice that reappears is not an interstitial, it is a broken screen, and looping on it would hide that.",
      "maxTimes": 1,
      "when": {
        "kind": "text_present",
        "text": { "kind": "literal", "value": "System Notice" }
      },
      "do": [
        {
          "kind": "click",
          "target": {
            "strategy": "semantic",
            "role": "button",
            "name": "OK",
            "nameSource": "native",
            "framePath": ["content"]
          }
        }
      ]
    }
  ],

  "provenance": {
    "discoveredBy": "human",
    "provider": null,
    "model": null,
    "runId": "phase1-hand-authored-0001",
    "discoveredAt": "2026-08-14T00:00:00.000Z",
    "transcriptHash": null,
    "toolVersions": {
      "target-app": "0.1.0",
      "schema": "1"
    }
  }
}
